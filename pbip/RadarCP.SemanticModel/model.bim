    "expressions": [
      {
        "name": "PastaDados",
        "kind": "m",
        "expression": "\"C:\\\\Projetos\\\\radar-contas-a-pagar\\\\data\\\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "fxLerCsv",
        "kind": "m",
        "expression": [
          "(arquivo as text) as table =>",
          "let",
          "    Origem   = Csv.Document(File.Contents(PastaDados & arquivo), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "    Promover = Table.PromoteHeaders(Origem, [PromoteAllScalars = true])",
          "in",
          "    Promover"
        ]
      }
    ],
