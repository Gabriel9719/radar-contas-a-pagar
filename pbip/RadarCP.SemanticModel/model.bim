            "sourceColumn": "[Coluna]",
            "lineageTag": "8aa2ba4f-b519-4c77-9d44-33a2ba67cadd",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Coluna\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Valor Total",
            "expression": "    SUM ( fTitulo[valor] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "93b9127d-228c-4ca7-9c34-e7d784ca820a"
          },
          {
            "name": "Qtd Títulos",
            "expression": "    COUNTROWS ( fTitulo )",
            "formatString": "#,0",
            "lineageTag": "1af8b6e6-5a64-42b0-98c3-2a41afffa060"
          },
          {
            "name": "Valor Pago",
            "expression": [
              "    CALCULATE (",
              "        [Valor Total],",
              "        NOT ISBLANK ( fTitulo[data_pagamento] ),",
              "        USERELATIONSHIP ( dCalendario[Data], fTitulo[data_pagamento] )",
              "    )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "04ad606d-c8c3-487f-955b-a8e6183db426"
          },
          {
            "name": "Valor em Aberto",
            "expression": "    CALCULATE ( [Valor Total], ISBLANK ( fTitulo[data_pagamento] ) )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "111876df-1161-4dd8-8d7e-82673ecac189"
          },
          {
            "name": "Data Base",
            "expression": "    CALCULATE ( MAX ( fTitulo[data_pagamento] ), REMOVEFILTERS () )",
            "formatString": "dd/mm/yyyy",
            "lineageTag": "7e9214df-1740-40b2-b045-6ebf5a2ad49f"
          },
          {
            "name": "Valor Vencido",
            "expression": [
              "    VAR _base = [Data Base]",
              "    RETURN",
              "        CALCULATE (",
              "            [Valor em Aberto],",
              "            KEEPFILTERS ( fTitulo[data_vencimento] < _base )",
              "        )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "e9fc0627-4159-447f-befe-84abb4674ca6"
          },
          {
            "name": "Qtd Exceções D+3",
            "expression": [
              "    CALCULATE (",
              "        [Qtd Títulos],",
              "        fTitulo[excecao_d3] = TRUE (),",
              "        USERELATIONSHIP ( dCalendario[Data], fTitulo[data_recebimento] )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "8c28fd12-9650-490f-9a4e-c24ad60bf6b0"
          },
          {
            "name": "Qtd Recebidos",
            "expression": "    CALCULATE ( [Qtd Títulos], USERELATIONSHIP ( dCalendario[Data], fTitulo[data_recebimento] ) )",
            "formatString": "#,0",
            "lineageTag": "a2cba826-176c-471c-96ca-2f9974b68087"
          },
          {
            "name": "% Exceção D+3",
            "expression": "    DIVIDE ( [Qtd Exceções D+3], [Qtd Recebidos] )",
            "formatString": "0.0%",
            "lineageTag": "d266009a-35f7-4e91-ab15-ec1c5cb91196"
          },
          {
            "name": "Meta % Exceção D+3",
            "expression": "0.15",
            "formatString": "0.0%",
            "lineageTag": "bc5c9a14-7a5c-479d-b4d1-2a366dfaa1cc"
          },
          {
            "name": "Status Meta D+3",
            "expression": "    IF ( [% Exceção D+3] <= [Meta % Exceção D+3], \"Dentro da meta\", \"Acima da meta\" )",
            "lineageTag": "2903f7ce-3e84-49c8-8c82-e4b1b11bf675"
          },
          {
            "name": "% Pago em Dia",
            "expression": [
              "    VAR _pagos =",
              "        CALCULATE ( [Qtd Títulos], NOT ISBLANK ( fTitulo[data_pagamento] ) )",
              "    VAR _emDia =",
              "        CALCULATE ( [Qtd Títulos], NOT ISBLANK ( fTitulo[data_pagamento] ), fTitulo[dias_atraso] <= 0 )",
              "    RETURN",
              "        DIVIDE ( _emDia, _pagos )"
            ],
            "formatString": "0.0%",
            "lineageTag": "1ebd8f1d-a6e0-4474-96fc-b29a1eb5a773"
          },
          {
            "name": "Valor Mês Anterior",
            "expression": [
              "    VAR _fimMesAtual = MAX ( dCalendario[Data] )",
              "    VAR _iniMesAnt = EOMONTH ( _fimMesAtual, -2 ) + 1",
              "    VAR _fimMesAnt = EOMONTH ( _fimMesAtual, -1 )",
              "    RETURN",
              "        CALCULATE (",
              "            [Valor Total],",
              "            REMOVEFILTERS ( dCalendario ),",
              "            DATESBETWEEN ( dCalendario[Data], _iniMesAnt, _fimMesAnt )",
              "        )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "2ce90d5a-ed77-474b-85f0-474c9a4ba803"
          },
          {
            "name": "Var % MoM",
            "expression": "    DIVIDE ( [Valor Total] - [Valor Mês Anterior], [Valor Mês Anterior] )",
            "formatString": "0.0%",
            "lineageTag": "5de9b2b9-23de-4b10-8ef2-2d1a92c3491e"
          },
          {
            "name": "Valor Acumulado no Ano",
            "expression": "    TOTALYTD ( [Valor Total], dCalendario[Data] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "352999b4-9d08-49a0-aa9d-c207770ff946"
          },
          {
            "name": "Valor Acumulado Ano Anterior",
            "expression": [
              "    VAR _ultimo = MIN ( MAX ( dCalendario[Data] ), [Data Base] )",
              "    RETURN",
              "        CALCULATE (",
              "            [Valor Total],",
              "            REMOVEFILTERS ( dCalendario ),",
              "            DATESBETWEEN (",
              "                dCalendario[Data],",
              "                DATE ( YEAR ( _ultimo ) - 1, 1, 1 ),",
              "                EDATE ( _ultimo, -12 )",
              "            )",
              "        )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "3042085a-9f6d-4444-a222-3930f97b6d20"
          },
          {
            "name": "Var % YoY (acumulado)",
            "expression": "    DIVIDE ( [Valor Acumulado no Ano] - [Valor Acumulado Ano Anterior], [Valor Acumulado Ano Anterior] )",
            "formatString": "0.0%",
            "lineageTag": "c0835bdb-982c-42d1-882a-6a474b218d39"
          },
          {
            "name": "% Acumulado ABC",
            "expression": [
              "    VAR _valorAtual = [Valor Total]",
              "    VAR _tabela =",
              "        ADDCOLUMNS ( ALLSELECTED ( dFornecedor[razao_social] ), \"@v\", [Valor Total] )",
              "    VAR _acumulado =",
              "        SUMX ( FILTER ( _tabela, [@v] >= _valorAtual ), [@v] )",
              "    RETURN",
              "        DIVIDE ( _acumulado, SUMX ( _tabela, [@v] ) )"
            ],
            "formatString": "0.0%",
            "lineageTag": "523353d0-f3e3-49ac-aa3f-6778852c2536"
          },
          {
            "name": "Classe ABC",
            "expression": [
              "    VAR _pct = [% Acumulado ABC]",
              "    VAR _part = DIVIDE ( [Valor Total], CALCULATE ( [Valor Total], ALLSELECTED ( dFornecedor ) ) )",
              "    RETURN",
              "        SWITCH ( TRUE (),",
              "            ISBLANK ( [Valor Total] ), BLANK (),",
              "            _pct - _part < 0.80, \"A\",",
              "            _pct - _part < 0.95, \"B\",",
              "            \"C\" )"
            ],
            "lineageTag": "bb14bfa8-ec84-4ff3-8e3a-9b030b545d79"
          },
          {
            "name": "Valor Aging",
            "expression": [
              "    VAR _base = [Data Base]",
              "    VAR _min = SELECTEDVALUE ( dFaixaAging[Min] )",
              "    VAR _max = SELECTEDVALUE ( dFaixaAging[Max] )",
              "    RETURN",
              "        SUMX (",
              "            FILTER (",
              "                fTitulo,",
              "                ISBLANK ( fTitulo[data_pagamento] )",
              "                    && VAR _d = INT ( _base - fTitulo[data_vencimento] )",
              "                       RETURN _d >= _min && _d <= _max",
              "            ),",
              "            fTitulo[valor]",
              "        )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "83b50fdf-b203-447d-a85b-4a5e6aea3b8a"
          },
          {
            "name": "Qtd Pagos sem Lançamento",
            "expression": [
              "    COUNTROWS (",
              "        FILTER (",
              "            fTitulo,",
              "            NOT ISBLANK ( fTitulo[data_pagamento] )",
              "                && ISEMPTY ( FILTER ( fRazao, fRazao[titulo_id] = fTitulo[titulo_id] ) )",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "e4f1bcfe-0b10-4356-9d97-3a2a46d7067c"
          },
          {
            "name": "Valor Razão",
            "expression": "    SUM ( fRazao[valor] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "4ba03d2e-8a41-418b-8142-9c83e64ecc43"
          },
          {
            "name": "Diferença Título x Razão",
            "expression": "    [Valor Pago] - CALCULATE ( [Valor Razão], NOT ISBLANK ( fRazao[titulo_id] ) )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "f86fb38c-1642-468b-a52f-0a3db87b3ed1"
          },
          {
            "name": "Pontos Produtividade",
            "expression": [
              "    SUMX (",
              "        fTitulo,",
              "        RELATED ( dFornecedor[peso_analise] )",
              "            + SWITCH ( TRUE (),",
              "                fTitulo[valor] <= 1000, 0.10,",
              "                fTitulo[valor] <= 2000, 0.20,",
              "                fTitulo[valor] <= 15000, 0.30,",
              "                fTitulo[valor] <= 100000, 0.40,",
              "                0.50 )",
              "    )"
            ],
            "lineageTag": "57a9000e-e4d3-496f-b73f-35d63e20dc37"
          },
          {
            "name": "Título Página",
            "expression": "    \"Radar CP · \" & FORMAT ( [Data Base], \"dd/mm/yyyy\" )",
            "lineageTag": "f5667457-a087-4311-93f3-d08854282b54"
          },
          {
            "name": "Cor Variação",
            "expression": "    IF ( [Var % MoM] > 0, \"#C0392B\", \"#00AE9D\" )",
            "lineageTag": "a8d564c1-9199-4446-bbfb-6a80ebd36b43"
          }
        ]
      }
    ],
