            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Faixa\", STRING, \"Ordem\", INTEGER, \"Min\", INTEGER, \"Max\", INTEGER, {{\"A vencer\", 1, -99999, 0}, {\"1-30\", 2, 1, 30}, {\"31-60\", 3, 31, 60}, {\"61-90\", 4, 61, 90}, {\"> 90\", 5, 91, 99999}})"
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "lineageTag": "14cefc96-bd4a-45de-8445-d08e91ef774e",
