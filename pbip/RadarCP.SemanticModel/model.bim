      {
        "name": "dCalendario",
        "lineageTag": "2c0eb312-41cb-4821-ada7-935e6dd2ea56",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "lineageTag": "8c10d502-171d-4fb0-9e86-d87ae4a9ff91",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy",
            "isKey": true
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "Ano",
            "lineageTag": "c8dbd498-4989-4eba-8aab-1bb77bbd30b3",
            "summarizeBy": "none"
          },
          {
            "name": "MesNum",
            "dataType": "int64",
            "sourceColumn": "MesNum",
            "lineageTag": "4a4e6111-9167-4fb4-b3d0-0d9e7fec60ba",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "lineageTag": "a693a961-a3f2-47f6-a63c-531902d74108",
            "summarizeBy": "none",
            "sortByColumn": "MesNum"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "lineageTag": "c4544c8b-b4e0-424a-8c5d-7fc8116cc5d2",
            "summarizeBy": "none"
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "sourceColumn": "Trimestre",
            "lineageTag": "f92c952c-3629-4837-9de3-17d98829193e",
            "summarizeBy": "none"
          },
          {
            "name": "DiaUtil",
            "dataType": "boolean",
            "sourceColumn": "DiaUtil",
            "lineageTag": "035d9b1e-363a-4035-9ea7-362ce789e565",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dCalendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas  = List.Combine({fTitulo[data_emissao], fTitulo[data_vencimento], List.RemoveNulls(fTitulo[data_pagamento])}),",
                "    Inicio = #date(Date.Year(List.Min(Datas)), 1, 1),",
                "    Fim    = #date(Date.Year(List.Max(Datas)), 12, 31),",
                "    Lista  = List.Dates(Inicio, Duration.Days(Fim - Inicio) + 1, #duration(1, 0, 0, 0)),",
                "    Tabela = Table.FromList(Lista, Splitter.SplitByNothing(), {\"Data\"}, null, ExtraValues.Error),",
                "    Tipo   = Table.TransformColumnTypes(Tabela, {{\"Data\", type date}}),",
                "    Ano    = Table.AddColumn(Tipo, \"Ano\", each Date.Year([Data]), Int64.Type),",
                "    MesNum = Table.AddColumn(Ano, \"MesNum\", each Date.Month([Data]), Int64.Type),",
                "    Mes    = Table.AddColumn(MesNum, \"Mes\", each Text.Proper(Date.ToText([Data], \"MMM\", \"pt-BR\")), type text),",
                "    AnoMes = Table.AddColumn(Mes, \"AnoMes\", each Date.ToText([Data], \"yyyy-MM\"), type text),",
                "    Trim   = Table.AddColumn(AnoMes, \"Trimestre\", each \"T\" & Text.From(Date.QuarterOfYear([Data])), type text),",
                "    DiaUtil = Table.AddColumn(Trim, \"DiaUtil\", each Date.DayOfWeek([Data], Day.Monday) < 5, type logical)",
                "in",
                "    DiaUtil"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "dFaixaAging",
        "lineageTag": "4b4a0d55-724f-4364-a9af-f2daa82529be",
